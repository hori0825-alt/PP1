# Vercel バックエンド用環境変数
# このファイルを .env にコピーし、実際のキーを入力してください。
# .env は .gitignore に含まれており、リポジトリにコミットされません。

# OpenAI API キー (必須)
OPENAI_API_KEY=sk-your-api-key-here

# 使用するモデル (省略時: gpt-4o)
OPENAI_MODEL=gpt-4o

# GitHub Pages からバックエンドを呼ぶ場合のフロントエンド設定 (Vite ビルド時):
# VITE_AI_API_URL=https://your-project.vercel.app
